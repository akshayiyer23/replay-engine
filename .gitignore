# ── Claude Code local settings ────────────────────────────────────────────────
.claude/

# ── raw scraped post data (never re-commit) ───────────────────────────────────
data/posts.json
data/labels-part1.json
data/candidates-part1.json

# ── secrets ───────────────────────────────────────────────────────────────────
.env

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/

# ── audio / video (never commit media files) ──────────────────────────────────
*.mp3
*.mp4
*.wav
*.m4a
*.webm
*.ogg
*.flac

# ── pipeline intermediate outputs (keep *.golden.json) ────────────────────────
data/*-content.json
data/*-content.md
data/*-candidates.json
data/*-qa.json
data/*-sentences.json
data/test-*
data/test_report.md
data/tmp*

# ── pipeline caches ───────────────────────────────────────────────────────────
data/.post_cache/
data/.raw_posts_cache.json
data/.transcript_cache.json

# ── raw pipeline JSON (diarization, transcript) — keep *.golden.json only ─────
# Any data/{slug}.json file without a suffix other than "-golden" is an intermediate
data/custom-ai-signals.json

# ── Next.js ───────────────────────────────────────────────────────────────────
web/.next/
web/node_modules/
web/.env.local
web/.env*.local

# ── baked static data (generated by scripts/bake_static.js at build time) ─────
web/public/data/
